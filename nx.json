{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.spec.tsx",
      "!{projectRoot}/e2e/**/*",
      "!{projectRoot}/**/*.md",
      "!{projectRoot}/**/__boundary-fixture__/**"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/vitest.config.mts",
      "{workspaceRoot}/vitest.setup.mts",
      "{workspaceRoot}/playwright.config.mts",
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/.nvmrc"
    ],
    "pruebas": [
      "production",
      "{projectRoot}/**/*.spec.ts",
      "{projectRoot}/**/*.spec.tsx"
    ],
    "navegador": [
      "pruebas",
      "{projectRoot}/e2e/**/*",
      "{workspaceRoot}/playwright.config.mts",
      "{workspaceRoot}/tools/poblar-cache.mts"
    ]
  },
  "targetDefaults": {
    "lint": {
      "cache": true,
      "inputs": ["pruebas", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["pruebas", "^production"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["pruebas", "^production"]
    },
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "e2e": {
      "cache": true,
      "dependsOn": ["build"],
      "inputs": ["navegador", "^production"],
      "outputs": ["{workspaceRoot}/test-results"]
    }
  },
  "defaultBase": "main"
}

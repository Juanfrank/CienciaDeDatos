{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "coherence",
  "projectType": "library",
  "sourceRoot": "tools/coherence",
  "tags": ["type:tooling", "scope:repo"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --dir tools/coherence"
      },
      "inputs": [
        "{projectRoot}/**/*",
        "{workspaceRoot}/tools/rename/segmentos.mjs",
        "{workspaceRoot}/tools/rename/glosario.json",
        "{workspaceRoot}/apps/shell/app/**/*",
        "{workspaceRoot}/apps/shell/src/**/*",
        "{workspaceRoot}/apps/shell/e2e/**/*",
        "{workspaceRoot}/packages/ui-components/src/registry/catalog.ts",
        "{workspaceRoot}/**/*.md",
        "{workspaceRoot}/**/AGENTS.md"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "eslint tools/coherence --max-warnings 0" }
    }
  }
}
